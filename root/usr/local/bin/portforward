#!/bin/bash

trap 'echo "SIGTERM received. Exiting.";exit 0' SIGTERM

main() {
    local oldport=0
    local port=0

    local port_file="$PORT_FILE"
    if [ -z "$port_file" ]; then
        port_file="/pia-shared/port.dat"
    fi
    local pf_path="$(dirname "$port_file")"
    local pf_file="${port_file##*/}"

    local auth=""
    if [ -n "$USER" ] || [ -n "$PASS" ]; then
        auth="-n $USER:$PASS"
    fi

    while true; do
        [ -r "$port_file" ] && port=$(cat "$port_file")
        if [ $oldport -ne $port ]; then
            echo "Setting Transmission port to ($port)."
            transmission-remote $auth -p $port
            oldport=$port
        fi
        inotifywait --event modify --event create --include "$pf_file" "$pf_path"
    done
}

main "$@"
exit $?